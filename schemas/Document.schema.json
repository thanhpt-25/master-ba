{
  "$defs": {
    "DocStatus": {
      "enum": [
        "draft",
        "in_review",
        "approved",
        "superseded"
      ],
      "title": "DocStatus",
      "type": "string"
    },
    "DocType": {
      "enum": [
        "BRD",
        "SRS",
        "BASIC_DESIGN",
        "DETAIL_DESIGN",
        "TEST_IT",
        "TEST_ST",
        "TEST_UT",
        "TEST_UAT"
      ],
      "title": "DocType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "content_ref": {
      "title": "Content Ref",
      "type": "string"
    },
    "id": {
      "pattern": "^DOC-(?:BRD|SRS|BASIC_DESIGN|DETAIL_DESIGN|TEST_IT|TEST_ST|TEST_UT|TEST_UAT)-\\d{4}$",
      "title": "Id",
      "type": "string"
    },
    "project_id": {
      "pattern": "^PRJ-\\d{3}$",
      "title": "Project Id",
      "type": "string"
    },
    "render_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Render Ref"
    },
    "status": {
      "$ref": "#/$defs/DocStatus"
    },
    "template_id": {
      "minLength": 1,
      "title": "Template Id",
      "type": "string"
    },
    "type": {
      "$ref": "#/$defs/DocType"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "type",
    "version",
    "status",
    "template_id",
    "content_ref",
    "project_id"
  ],
  "title": "Document",
  "type": "object"
}
