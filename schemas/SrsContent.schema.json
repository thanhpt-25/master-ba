{
  "$defs": {
    "DocumentSection": {
      "additionalProperties": false,
      "description": "Document-level prose (背景・目的, 制約事項, ...) with the sources it rests on.\n\nSources are intake citations (`intake/<file>#L<a>-L<b>`) in a BRD and upstream REQ ids or\nitem refs in later documents. Sections are not items: they carry no id and no trace link.",
      "properties": {
        "body": {
          "minLength": 1,
          "title": "Body",
          "type": "string"
        },
        "key": {
          "$ref": "#/$defs/SectionKey"
        },
        "sources": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "key",
        "body",
        "sources"
      ],
      "title": "DocumentSection",
      "type": "object"
    },
    "ItemStatus": {
      "enum": [
        "active",
        "removed"
      ],
      "title": "ItemStatus",
      "type": "string"
    },
    "KbCitation": {
      "additionalProperties": false,
      "properties": {
        "chunk_ref": {
          "minLength": 1,
          "title": "Chunk Ref",
          "type": "string"
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        }
      },
      "required": [
        "chunk_ref"
      ],
      "title": "KbCitation",
      "type": "object"
    },
    "SectionKey": {
      "description": "A prose section of a document (spec 19 part 2).",
      "enum": [
        "background",
        "constraints",
        "system_overview",
        "it_viewpoints"
      ],
      "title": "SectionKey",
      "type": "string"
    },
    "SrsItem": {
      "additionalProperties": false,
      "properties": {
        "acceptance_hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Acceptance Hint"
        },
        "derives_from": {
          "items": {
            "pattern": "^REQ-\\d{4}$",
            "type": "string"
          },
          "title": "Derives From",
          "type": "array"
        },
        "item_id": {
          "pattern": "^DOC-(?:BRD|SRS|BASIC_DESIGN|DETAIL_DESIGN|TEST_IT|TEST_ST|TEST_UT|TEST_UAT)-\\d{4}#item\\.\\d+$",
          "title": "Item Id",
          "type": "string"
        },
        "kb_citations": {
          "items": {
            "$ref": "#/$defs/KbCitation"
          },
          "title": "Kb Citations",
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/SrsKind"
        },
        "requirement_id": {
          "pattern": "^REQ-\\d{4}$",
          "title": "Requirement Id",
          "type": "string"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ItemStatus",
          "default": "active"
        }
      },
      "required": [
        "item_id",
        "requirement_id",
        "kind",
        "statement"
      ],
      "title": "SrsItem",
      "type": "object"
    },
    "SrsKind": {
      "enum": [
        "functional",
        "non_functional"
      ],
      "title": "SrsKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/SrsItem"
      },
      "title": "Items",
      "type": "array"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/DocumentSection"
      },
      "title": "Sections",
      "type": "array"
    }
  },
  "required": [
    "items"
  ],
  "title": "SrsContent",
  "type": "object"
}
