{
  "$defs": {
    "DraftRequirement": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "$ref": "#/$defs/ReqCategory"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "evidence_quote": {
          "minLength": 1,
          "title": "Evidence Quote",
          "type": "string"
        },
        "kb_citations": {
          "items": {
            "$ref": "#/$defs/KbCitation"
          },
          "title": "Kb Citations",
          "type": "array"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "description",
        "category",
        "scope",
        "start_line",
        "end_line",
        "evidence_quote"
      ],
      "title": "DraftRequirement",
      "type": "object"
    },
    "DraftSection": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "minLength": 1,
          "title": "Body",
          "type": "string"
        },
        "key": {
          "$ref": "#/$defs/SectionKey"
        },
        "sources": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "key",
        "body",
        "sources"
      ],
      "title": "DraftSection",
      "type": "object"
    },
    "KbCitation": {
      "additionalProperties": false,
      "properties": {
        "chunk_ref": {
          "minLength": 1,
          "title": "Chunk Ref",
          "type": "string"
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        }
      },
      "required": [
        "chunk_ref"
      ],
      "title": "KbCitation",
      "type": "object"
    },
    "OpenQuestion": {
      "additionalProperties": false,
      "properties": {
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "question": {
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "question",
        "start_line",
        "end_line"
      ],
      "title": "OpenQuestion",
      "type": "object"
    },
    "ReqCategory": {
      "enum": [
        "business",
        "functional",
        "non_functional"
      ],
      "title": "ReqCategory",
      "type": "string"
    },
    "Scope": {
      "enum": [
        "in",
        "out"
      ],
      "title": "Scope",
      "type": "string"
    },
    "SectionKey": {
      "description": "A prose section of a document (spec 19 part 2).",
      "enum": [
        "background",
        "constraints",
        "system_overview",
        "it_viewpoints"
      ],
      "title": "SectionKey",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "open_questions": {
      "items": {
        "$ref": "#/$defs/OpenQuestion"
      },
      "title": "Open Questions",
      "type": "array"
    },
    "requirements": {
      "items": {
        "$ref": "#/$defs/DraftRequirement"
      },
      "minItems": 1,
      "title": "Requirements",
      "type": "array"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/DraftSection"
      },
      "title": "Sections",
      "type": "array"
    }
  },
  "required": [
    "requirements"
  ],
  "title": "BrdDraft",
  "type": "object"
}
