{
  "$defs": {
    "PatchOp": {
      "additionalProperties": false,
      "properties": {
        "fields": {
          "additionalProperties": true,
          "title": "Fields",
          "type": "object"
        },
        "item_id": {
          "anyOf": [
            {
              "pattern": "^DOC-(?:BRD|SRS|BASIC_DESIGN|DETAIL_DESIGN|TEST_IT|TEST_ST|TEST_UT|TEST_UAT)-\\d{4}#item\\.\\d+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Item Id"
        },
        "op": {
          "enum": [
            "update",
            "add",
            "remove"
          ],
          "title": "Op",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "op",
        "reason"
      ],
      "title": "PatchOp",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "operations": {
      "items": {
        "$ref": "#/$defs/PatchOp"
      },
      "title": "Operations",
      "type": "array"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    }
  },
  "required": [
    "summary"
  ],
  "title": "RevisionPatch",
  "type": "object"
}
