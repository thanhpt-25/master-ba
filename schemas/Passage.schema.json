{
  "additionalProperties": false,
  "properties": {
    "chunk_ref": {
      "pattern": "^KB-\\d{4}#chunk\\.[1-9]\\d*$",
      "title": "Chunk Ref",
      "type": "string"
    },
    "heading_path": {
      "items": {
        "type": "string"
      },
      "title": "Heading Path",
      "type": "array"
    },
    "page": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Page"
    },
    "rows": {
      "anyOf": [
        {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rows"
    },
    "score": {
      "title": "Score",
      "type": "number"
    },
    "sheet": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sheet"
    },
    "text": {
      "title": "Text",
      "type": "string"
    }
  },
  "required": [
    "chunk_ref",
    "text",
    "score"
  ],
  "title": "Passage",
  "type": "object"
}
