{
  "$defs": {
    "BasicDesignItem": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "item_id": {
          "pattern": "^DOC-(?:BRD|SRS|BASIC_DESIGN|DETAIL_DESIGN|TEST_IT|TEST_ST|TEST_UT|TEST_UAT)-\\d{4}#item\\.\\d+$",
          "title": "Item Id",
          "type": "string"
        },
        "kb_citations": {
          "items": {
            "$ref": "#/$defs/KbCitation"
          },
          "title": "Kb Citations",
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/BasicDesignKind"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "realizes": {
          "items": {
            "pattern": "^(?:REQ-\\d{4}|DOC-(?:BRD|SRS|BASIC_DESIGN|DETAIL_DESIGN|TEST_IT|TEST_ST|TEST_UT|TEST_UAT)-\\d{4}#item\\.\\d+)$",
            "type": "string"
          },
          "title": "Realizes",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/ItemStatus",
          "default": "active"
        }
      },
      "required": [
        "item_id",
        "kind",
        "name",
        "description"
      ],
      "title": "BasicDesignItem",
      "type": "object"
    },
    "BasicDesignKind": {
      "enum": [
        "function",
        "screen",
        "interface",
        "data_entity"
      ],
      "title": "BasicDesignKind",
      "type": "string"
    },
    "ItemStatus": {
      "enum": [
        "active",
        "removed"
      ],
      "title": "ItemStatus",
      "type": "string"
    },
    "KbCitation": {
      "additionalProperties": false,
      "properties": {
        "chunk_ref": {
          "minLength": 1,
          "title": "Chunk Ref",
          "type": "string"
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        }
      },
      "required": [
        "chunk_ref"
      ],
      "title": "KbCitation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/BasicDesignItem"
      },
      "title": "Items",
      "type": "array"
    }
  },
  "required": [
    "items"
  ],
  "title": "BasicDesignContent",
  "type": "object"
}
