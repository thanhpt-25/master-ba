{
  "$defs": {
    "ChangeType": {
      "enum": [
        "added",
        "removed",
        "field_changed"
      ],
      "title": "ChangeType",
      "type": "string"
    },
    "Classification": {
      "enum": [
        "reworded_only",
        "structural_change"
      ],
      "title": "Classification",
      "type": "string"
    },
    "JsonValue": {}
  },
  "additionalProperties": false,
  "properties": {
    "change_type": {
      "$ref": "#/$defs/ChangeType"
    },
    "classification": {
      "$ref": "#/$defs/Classification"
    },
    "field": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Field"
    },
    "item_id": {
      "pattern": "^DOC-(?:BRD|SRS|BASIC_DESIGN|DETAIL_DESIGN|TEST_IT|TEST_ST|TEST_UT|TEST_UAT)-\\d{4}#item\\.\\d+$",
      "title": "Item Id",
      "type": "string"
    },
    "new": {
      "$ref": "#/$defs/JsonValue",
      "default": null
    },
    "old": {
      "$ref": "#/$defs/JsonValue",
      "default": null
    }
  },
  "required": [
    "item_id",
    "change_type",
    "classification"
  ],
  "title": "ItemChange",
  "type": "object"
}
