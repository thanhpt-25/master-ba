{
  "$defs": {
    "ItemStatus": {
      "enum": [
        "active",
        "removed"
      ],
      "title": "ItemStatus",
      "type": "string"
    },
    "Level": {
      "enum": [
        "UT",
        "IT",
        "ST",
        "UAT"
      ],
      "title": "Level",
      "type": "string"
    },
    "TestCaseItem": {
      "additionalProperties": false,
      "properties": {
        "expected": {
          "minLength": 1,
          "title": "Expected",
          "type": "string"
        },
        "input": {
          "title": "Input",
          "type": "string"
        },
        "item_id": {
          "pattern": "^DOC-(?:BRD|SRS|BASIC_DESIGN|DETAIL_DESIGN|TEST_IT|TEST_ST|TEST_UT|TEST_UAT)-\\d{4}#item\\.\\d+$",
          "title": "Item Id",
          "type": "string"
        },
        "level": {
          "$ref": "#/$defs/Level"
        },
        "precondition": {
          "title": "Precondition",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ItemStatus",
          "default": "active"
        },
        "steps": {
          "items": {
            "type": "string"
          },
          "title": "Steps",
          "type": "array"
        },
        "test_id": {
          "pattern": "^TC-(?:UT|IT|ST|UAT)-\\d{4}$",
          "title": "Test Id",
          "type": "string"
        },
        "verifies": {
          "items": {
            "pattern": "^(?:REQ-\\d{4}|DOC-(?:BRD|SRS|BASIC_DESIGN|DETAIL_DESIGN|TEST_IT|TEST_ST|TEST_UT|TEST_UAT)-\\d{4}#item\\.\\d+)$",
            "type": "string"
          },
          "title": "Verifies",
          "type": "array"
        }
      },
      "required": [
        "item_id",
        "test_id",
        "level",
        "precondition",
        "input",
        "steps",
        "expected"
      ],
      "title": "TestCaseItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/TestCaseItem"
      },
      "title": "Items",
      "type": "array"
    }
  },
  "required": [
    "items"
  ],
  "title": "TestSpecContent",
  "type": "object"
}
