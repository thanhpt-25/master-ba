{
  "$defs": {
    "DesignQuestion": {
      "additionalProperties": false,
      "properties": {
        "question": {
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "ref": {
          "pattern": "^DOC-(?:BRD|SRS|BASIC_DESIGN|DETAIL_DESIGN|TEST_IT|TEST_ST|TEST_UT|TEST_UAT)-\\d{4}#item\\.\\d+$",
          "title": "Ref",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "question"
      ],
      "title": "DesignQuestion",
      "type": "object"
    },
    "DraftExclusion": {
      "additionalProperties": false,
      "properties": {
        "item_ref": {
          "pattern": "^DOC-(?:BRD|SRS|BASIC_DESIGN|DETAIL_DESIGN|TEST_IT|TEST_ST|TEST_UT|TEST_UAT)-\\d{4}#item\\.\\d+$",
          "title": "Item Ref",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "item_ref",
        "reason"
      ],
      "title": "DraftExclusion",
      "type": "object"
    },
    "DraftTestCase": {
      "additionalProperties": false,
      "properties": {
        "expected": {
          "minLength": 1,
          "title": "Expected",
          "type": "string"
        },
        "input": {
          "title": "Input",
          "type": "string"
        },
        "precondition": {
          "title": "Precondition",
          "type": "string"
        },
        "steps": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "verifies": {
          "items": {
            "pattern": "^DOC-(?:BRD|SRS|BASIC_DESIGN|DETAIL_DESIGN|TEST_IT|TEST_ST|TEST_UT|TEST_UAT)-\\d{4}#item\\.\\d+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Verifies",
          "type": "array"
        }
      },
      "required": [
        "precondition",
        "input",
        "steps",
        "expected",
        "verifies"
      ],
      "title": "DraftTestCase",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "exclusions": {
      "items": {
        "$ref": "#/$defs/DraftExclusion"
      },
      "title": "Exclusions",
      "type": "array"
    },
    "it_cases": {
      "items": {
        "$ref": "#/$defs/DraftTestCase"
      },
      "title": "It Cases",
      "type": "array"
    },
    "questions": {
      "items": {
        "$ref": "#/$defs/DesignQuestion"
      },
      "title": "Questions",
      "type": "array"
    },
    "st_cases": {
      "items": {
        "$ref": "#/$defs/DraftTestCase"
      },
      "title": "St Cases",
      "type": "array"
    }
  },
  "title": "TestDraft",
  "type": "object"
}
