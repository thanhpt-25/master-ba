{
  "$defs": {
    "BasicDesignKind": {
      "enum": [
        "function",
        "screen",
        "interface",
        "data_entity"
      ],
      "title": "BasicDesignKind",
      "type": "string"
    },
    "DesignAnswer": {
      "additionalProperties": false,
      "description": "The designer's reply to a tester question about one design item.",
      "properties": {
        "ref": {
          "pattern": "^DOC-(?:BRD|SRS|BASIC_DESIGN|DETAIL_DESIGN|TEST_IT|TEST_ST|TEST_UT|TEST_UAT)-\\d{4}#item\\.\\d+$",
          "title": "Ref",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "text"
      ],
      "title": "DesignAnswer",
      "type": "object"
    },
    "DraftDesignItem": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "kb_citations": {
          "items": {
            "$ref": "#/$defs/KbCitation"
          },
          "title": "Kb Citations",
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/BasicDesignKind"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "realizes": {
          "items": {
            "pattern": "^DOC-(?:BRD|SRS|BASIC_DESIGN|DETAIL_DESIGN|TEST_IT|TEST_ST|TEST_UT|TEST_UAT)-\\d{4}#item\\.\\d+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Realizes",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "name",
        "description",
        "realizes"
      ],
      "title": "DraftDesignItem",
      "type": "object"
    },
    "DraftSection": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "minLength": 1,
          "title": "Body",
          "type": "string"
        },
        "key": {
          "$ref": "#/$defs/SectionKey"
        },
        "sources": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "key",
        "body",
        "sources"
      ],
      "title": "DraftSection",
      "type": "object"
    },
    "KbCitation": {
      "additionalProperties": false,
      "properties": {
        "chunk_ref": {
          "minLength": 1,
          "title": "Chunk Ref",
          "type": "string"
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        }
      },
      "required": [
        "chunk_ref"
      ],
      "title": "KbCitation",
      "type": "object"
    },
    "SectionKey": {
      "description": "A prose section of a document (spec 19 part 2).",
      "enum": [
        "background",
        "constraints",
        "system_overview",
        "it_viewpoints"
      ],
      "title": "SectionKey",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "answers": {
      "items": {
        "$ref": "#/$defs/DesignAnswer"
      },
      "title": "Answers",
      "type": "array"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/DraftDesignItem"
      },
      "minItems": 1,
      "title": "Items",
      "type": "array"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/DraftSection"
      },
      "title": "Sections",
      "type": "array"
    }
  },
  "required": [
    "items"
  ],
  "title": "BasicDesignDraft",
  "type": "object"
}
