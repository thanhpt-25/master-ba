{
  "$defs": {
    "DetailDesignItem": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "pattern": "^DOC-(?:BRD|SRS|BASIC_DESIGN|DETAIL_DESIGN|TEST_IT|TEST_ST|TEST_UT|TEST_UAT)-\\d{4}#item\\.\\d+$",
          "title": "Item Id",
          "type": "string"
        },
        "kb_citations": {
          "items": {
            "$ref": "#/$defs/KbCitation"
          },
          "title": "Kb Citations",
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/DetailDesignKind"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "refines": {
          "items": {
            "pattern": "^DOC-(?:BRD|SRS|BASIC_DESIGN|DETAIL_DESIGN|TEST_IT|TEST_ST|TEST_UT|TEST_UAT)-\\d{4}#item\\.\\d+$",
            "type": "string"
          },
          "title": "Refines",
          "type": "array"
        },
        "spec": {
          "title": "Spec",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ItemStatus",
          "default": "active"
        }
      },
      "required": [
        "item_id",
        "kind",
        "name",
        "spec"
      ],
      "title": "DetailDesignItem",
      "type": "object"
    },
    "DetailDesignKind": {
      "enum": [
        "module",
        "processing_step",
        "db_table",
        "api"
      ],
      "title": "DetailDesignKind",
      "type": "string"
    },
    "ItemStatus": {
      "enum": [
        "active",
        "removed"
      ],
      "title": "ItemStatus",
      "type": "string"
    },
    "KbCitation": {
      "additionalProperties": false,
      "properties": {
        "chunk_ref": {
          "minLength": 1,
          "title": "Chunk Ref",
          "type": "string"
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        }
      },
      "required": [
        "chunk_ref"
      ],
      "title": "KbCitation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/DetailDesignItem"
      },
      "title": "Items",
      "type": "array"
    }
  },
  "required": [
    "items"
  ],
  "title": "DetailDesignContent",
  "type": "object"
}
