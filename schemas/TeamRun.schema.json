{
  "$defs": {
    "DocType": {
      "enum": [
        "BRD",
        "SRS",
        "BASIC_DESIGN",
        "DETAIL_DESIGN",
        "TEST_IT",
        "TEST_ST",
        "TEST_UT",
        "TEST_UAT"
      ],
      "title": "DocType",
      "type": "string"
    },
    "TeamRunStatus": {
      "enum": [
        "running",
        "done",
        "escalated"
      ],
      "title": "TeamRunStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "escalations": {
      "items": {
        "type": "string"
      },
      "title": "Escalations",
      "type": "array"
    },
    "issues_raised": {
      "minimum": 0,
      "title": "Issues Raised",
      "type": "integer"
    },
    "issues_resolved": {
      "minimum": 0,
      "title": "Issues Resolved",
      "type": "integer"
    },
    "rounds": {
      "minimum": 0,
      "title": "Rounds",
      "type": "integer"
    },
    "run_id": {
      "pattern": "^RUN-\\d{4}$",
      "title": "Run Id",
      "type": "string"
    },
    "stage": {
      "$ref": "#/$defs/DocType"
    },
    "status": {
      "$ref": "#/$defs/TeamRunStatus"
    },
    "tokens_used": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tokens Used"
    },
    "trigger": {
      "pattern": "^(?:initial|DR-\\d{4})$",
      "title": "Trigger",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "stage",
    "trigger",
    "status",
    "rounds",
    "issues_raised",
    "issues_resolved"
  ],
  "title": "TeamRun",
  "type": "object"
}
