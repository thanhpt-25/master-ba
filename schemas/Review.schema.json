{
  "$defs": {
    "ReviewComment": {
      "additionalProperties": false,
      "properties": {
        "ref": {
          "anyOf": [
            {
              "pattern": "^DOC-(?:BRD|SRS|BASIC_DESIGN|DETAIL_DESIGN|TEST_IT|TEST_ST|TEST_UT|TEST_UAT)-\\d{4}#item\\.\\d+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ref"
        },
        "text": {
          "maxLength": 2000,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "ReviewComment",
      "type": "object"
    },
    "ReviewDecision": {
      "enum": [
        "approved",
        "rejected"
      ],
      "title": "ReviewDecision",
      "type": "string"
    },
    "ReviewStage": {
      "description": "A phase that is reviewed as a whole (spec 15 section 1).",
      "enum": [
        "brd",
        "srs",
        "basic",
        "detail"
      ],
      "title": "ReviewStage",
      "type": "string"
    },
    "ReviewedDocument": {
      "additionalProperties": false,
      "properties": {
        "doc_id": {
          "pattern": "^DOC-(?:BRD|SRS|BASIC_DESIGN|DETAIL_DESIGN|TEST_IT|TEST_ST|TEST_UT|TEST_UAT)-\\d{4}$",
          "title": "Doc Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "doc_id",
        "version"
      ],
      "title": "ReviewedDocument",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "at": {
      "format": "date-time",
      "title": "At",
      "type": "string"
    },
    "by": {
      "minLength": 1,
      "title": "By",
      "type": "string"
    },
    "comments": {
      "items": {
        "$ref": "#/$defs/ReviewComment"
      },
      "title": "Comments",
      "type": "array"
    },
    "decision": {
      "$ref": "#/$defs/ReviewDecision"
    },
    "documents": {
      "items": {
        "$ref": "#/$defs/ReviewedDocument"
      },
      "minItems": 1,
      "title": "Documents",
      "type": "array"
    },
    "dr_id": {
      "anyOf": [
        {
          "pattern": "^DR-\\d{4}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dr Id"
    },
    "id": {
      "pattern": "^REV-\\d{4}$",
      "title": "Id",
      "type": "string"
    },
    "open_questions": {
      "items": {
        "pattern": "^Q-\\d{4}$",
        "type": "string"
      },
      "title": "Open Questions",
      "type": "array"
    },
    "revision_run": {
      "anyOf": [
        {
          "pattern": "^RUN-\\d{4}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Revision Run"
    },
    "stage": {
      "$ref": "#/$defs/ReviewStage"
    }
  },
  "required": [
    "id",
    "stage",
    "documents",
    "decision",
    "by",
    "at"
  ],
  "title": "Review",
  "type": "object"
}
