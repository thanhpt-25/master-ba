# Copy to .env (gitignored) and fill in. Never commit a key.
ANTHROPIC_API_KEY=
# A gateway on the host is reached from the container as http://host.docker.internal:<port>
ANTHROPIC_BASE_URL=
MASTERBA_MODEL=
# Raise for large intakes; a failed request escalates the run so it can be resumed.
MASTERBA_REQUEST_TIMEOUT=
MASTERBA_MAX_TOKENS=
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
